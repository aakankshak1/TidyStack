{
  "manifest_version": 3,
  "name": "Tab Tamer",
  "version": "2.0.0",
  "description": "A calm way to manage too many tabs. Nothing is ever deleted without your say -- archive, search, and restore, all on your device.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Tamer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "tabGroups", "storage", "alarms", "notifications"]
}
