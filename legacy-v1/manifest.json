{
  "manifest_version": 3,
  "name": "Tab Tamer",
  "version": "1.0.0",
  "description": "Detects tab overload, groups tabs by topic, and helps you close or bookmark stale ones.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "bookmarks",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Tamer"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
